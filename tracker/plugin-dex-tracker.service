[Unit]
Description=PluginDex asia download tracker
After=network.target

[Service]
Type=simple
EnvironmentFile=/etc/plugin-dex/tracker.env
ExecStart=/usr/bin/python3 /opt/plugin-dex-tracker/app.py
Restart=always
RestartSec=2
User=www-data
Group=www-data
WorkingDirectory=/opt/plugin-dex-tracker

[Install]
WantedBy=multi-user.target
