# Public site origin used for canonical URLs, Open Graph, sitemap, and robots.
# Example production value: https://wppluginindex.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional override for the SQLite catalog path (defaults to ./data/plugins.sqlite)
# PLUGINDEX_DB_PATH=/absolute/path/to/plugins.sqlite

# Private download/view tracker DB (defaults to ./data/stats.sqlite)
# PLUGINDEX_STATS_DB_PATH=/absolute/path/to/stats.sqlite

# Gate for /stats?key=… and POST /api/indexnow?key=…
# Production uses the same shared key as plugin-dex.forum unless you rotate it.
STATS_KEY=

# IndexNow key (Bing + partners). Served at /{INDEXNOW_KEY}.txt
INDEXNOW_KEY=wpiindexnow7f91a9957194

# Optional search-engine site verification meta tags
# GOOGLE_SITE_VERIFICATION=
# BING_SITE_VERIFICATION=
