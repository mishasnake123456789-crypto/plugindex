{
  "name": "plugindex",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/ensure-db.mjs",
    "dev": "next dev --turbopack",
    "prebuild": "node scripts/ensure-db.mjs",
    "build": "next build --turbopack",
    "prestart": "node scripts/ensure-db.mjs",
    "start": "next start",
    "lint": "eslint",
    "ensure-db": "node scripts/ensure-db.mjs",
    "sync": "node --experimental-sqlite scripts/sync-plugins.mjs",
    "sync:sample": "node --experimental-sqlite scripts/sync-plugins.mjs --max-pages 3",
    "sync:pack": "gzip -kf -9 data/plugins.sqlite"
  },
  "dependencies": {
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "next": "15.5.28"
  },
  "devDependencies": {
    "typescript": "^5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@tailwindcss/postcss": "^4",
    "tailwindcss": "^4",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "@eslint/eslintrc": "^3"
  }
}
